{$QUERY_PILOT_SITE_ADDRESS::80} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	handle /api/* {
		request_body {
			max_size 128KB
		}
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header /index.html Cache-Control no-cache
		file_server
	}
}
